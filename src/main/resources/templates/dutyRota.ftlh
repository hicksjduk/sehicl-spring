<h1>Duty team rota 2026-27</h1>
<p>
	<a href="/rules/administration#dutyteam">The League's rules</a> state
	that the designated duty team for each evening must attend and operate
	the manual scoreboards for all senior (<i>not</i> Colts) games on the designated evening.
</p>
<#--
<p>The duty rota will be published shortly.</p>
-->
<table id="dutyrota">
	<tbody>
<@duty "20th September" "Waterlooville A" />
<@duty "27th September" "Buffalo Portsmouth" />
<@duty "11th October" "Bishops Waltham" />
<@duty "18th October" "Hambledon A" />
<@duty "25th October" "Clanfield B" />
<@duty "1st November" "Portsmouth Community" />
<@duty "8th November" "XIIth Men A" />
<@duty "15th November" "Bedhampton Mariners" />
<@duty "22nd November" "Kerala A" />
<@duty "29th November" "Clanfield A" />
<@duty "6th December" "Superkings" />
<@duty "13th December" "Portsmouth A" />
<@duty "20th December" "Hambledon B" />
<@duty "3rd January" "Hambledon C" />
<@duty "10th January" "Clanfield C" />
<@duty "17th January" "OPCS Titchfield A" />
<@duty "24th January" "Purbrook" />
<@duty "3rd January" "Portsmouth & Southsea" />
<@duty "7th February" "Kerala B" />
